  "levels": {
    "catalog": { "models": 0, "cases": 0, "repeats": 0, "maxSpendUsd": 0, "maxConcurrency": 0, "maxRetries": 0 },
    "preview": { "models": 1, "cases": 3, "repeats": 1, "maxSpendUsd": 1, "maxConcurrency": 1, "maxRetries": 0 },
    "comparison": { "models": 6, "cases": 10, "repeats": 3, "maxSpendUsd": 10, "maxConcurrency": 3, "maxRetries": 1 }
